---
import type { Locale } from '../../config/site';
import { profile } from '../../data/profile';
const { locale } = Astro.props as { locale: Locale };
---
<footer class="site-footer">
  <div class="container footer-row">
    <span>© 2027 Khaled Zouari</span>
    <nav class="footer-links" aria-label={locale === 'fr' ? 'Liens complémentaires' : 'Additional links'}><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={`mailto:${profile.email}`}>Email</a></nav>
  </div>
</footer>
